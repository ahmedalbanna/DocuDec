    "Glossary": {
        "Terms": [
            {
                "Term": "API",
                "Definition": "Application Programming Interfaces"
            },
            {
                "Term": "Diagram Generation",
                "Definition": "Producing graphics"
            },
            {
                "Term": "Real-world Impact",
                "Definition": "Realistic effect"
            },
            {
                "Term": "Diagram Format",
                "Definition": "PlantUML"
            },
            {
                "Term": "UI/UX",
                "Definition": "User interface refers to the visual elements of a product or digital interface, while user experience takes into account the overall experience and interaction a user has with the product or service."
            },
            {
                "Term": "RESTful API",
                "Definition": "An API that uses HTTP requests to fetch, place, publish, and delete data, providing a lightweight, maintainable, and scalable interface to web services."
            },
            {
                "Term": "Natural Language Processing (NLP)",
                "Definition": "The branch of artificial intelligence that deals with the interaction between computers and humans using natural language, and involves actively reading, understanding, and analyzing human languages."
            },
            {
                "Term": "OAuth 2.0",
                "Definition": "An open standard for access delegation, typically used to give websites or apps limited access to user information without revealing passwords."
            },
            {
                "Term": "Entity-Relationship Diagram (ERD)",
                "Definition": "A diagram that shows the relationships between entities in a database, often used in data design to organize the relationships between them."
            },
            {
                "Term": "Gantt",
                "Definition": "Gantt charts to display project schedules and timelines."
            }
        ]
